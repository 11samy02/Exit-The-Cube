; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Exit The Cube"
run/main_scene="res://Scenes/Ui/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cgmh5upmrsqmb"

[autoload]

Settings="*res://Scripts/Settings/settings_manager.gd"
InputIcons="*res://Scripts/Ui/input_icons.gd"
Seats="*res://Scripts/Match/seat_table.gd"
UiFeedback="*res://Scripts/Ui/ui_feedback.gd"
DeathMarks="*res://Scripts/Enviroment/death_marks.gd"
GameState="*res://Scripts/game_state.gd"
Levels="*res://Scripts/Enviroment/level_progress.gd"
SaveGame="*res://Scripts/Settings/save_game.gd"
ItemSystem="*res://Scripts/Items/item_system.gd"
Quips="*res://Scripts/Ui/quips.gd"
Music="*res://Scenes/Audio/music.tscn"
Transition="*res://Scripts/Ui/transition.gd"
Status="*res://Scripts/Player/Status/status_system.gd"
Match="*res://Scripts/Match/match_router.gd"
Online="*res://Scripts/Online/online.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

